{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "max-lines": ["error", { "max": 500 }]
  },
  "overrides": [
    {
      "files": [
        "src/api.ts",
        "src/demo/backend.ts",
        "src/features/services/Service.tsx",
        "src/features/projects/Project.tsx",
        "src/features/account/Account.tsx",
        "src/features/settings/Servers.tsx",
        "src/features/services/env-entry-dialog.tsx",
        "src/features/services/errors-tab.tsx",
        "src/features/files/files-tab.tsx",
        "src/features/map/canvas/map3d.tsx",
        "src/features/services/settings/networking.tsx",
        "src/features/data/mongo-browser.tsx",
        "src/features/data/pg-browser.tsx",
        "src/features/data/redis-browser.tsx"
      ],
      "rules": { "max-lines": "off" }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "no-empty-pattern": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
      }
    }
  ]
}
