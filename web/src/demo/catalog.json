{
  "templates": [
    {
      "id": "beszel-agent",
      "title": "Beszel agent",
      "description": "Reports this server's CPU, memory, disks, network and containers to a Beszel hub.",
      "website": "https://beszel.dev",
      "docs": "https://beszel.dev/guide/agent-installation",
      "icon": "beszel",
      "category": "monitoring",
      "tags": [
        "metrics",
        "docker",
        "agent"
      ],
      "inputs": [
        {
          "name": "KEY",
          "label": "Hub public key",
          "type": "text",
          "help": "In the hub, Add System shows it. Give the system this server's address and port 45876.",
          "placeholder": "ssh-ed25519 AAAA…",
          "required": true
        },
        {
          "name": "TOKEN",
          "label": "Token",
          "type": "secret",
          "help": "With the hub URL, the agent connects to the hub itself (no open port needed)."
        },
        {
          "name": "HUB_URL",
          "label": "Hub URL",
          "type": "url",
          "help": "Needed with the token.",
          "placeholder": "https://beszel.example.com"
        }
      ],
      "project": "beszel-agent",
      "compose": "",
      "services": [
        {
          "name": "agent",
          "kind": "app",
          "image": "henrygd/beszel-agent",
          "icon": "beszel",
          "hostNetwork": true,
          "dockerSocket": "ro"
        }
      ]
    },
    {
      "id": "beszel-hub",
      "title": "Beszel hub",
      "description": "Lightweight server monitoring with history, Docker stats and alerts. Install the Beszel agent on each server to watch.",
      "website": "https://beszel.dev",
      "docs": "https://beszel.dev/guide/getting-started",
      "icon": "beszel",
      "category": "monitoring",
      "tags": [
        "metrics",
        "docker",
        "alerts"
      ],
      "inputs": [
        {
          "name": "DOMAIN",
          "label": "Domain",
          "type": "domain",
          "help": "Where the dashboard is served. The first visit creates the admin account.",
          "placeholder": "beszel.example.com",
          "required": true
        }
      ],
      "project": "beszel",
      "compose": "",
      "services": [
        {
          "name": "hub",
          "kind": "app",
          "image": "henrygd/beszel",
          "icon": "beszel",
          "port": 8090,
          "volumes": [
            {
              "name": "data",
              "path": "/beszel_data"
            }
          ],
          "domainInput": "DOMAIN"
        }
      ]
    },
    {
      "id": "minecraft",
      "title": "Minecraft server",
      "description": "A Minecraft Java Edition server, vanilla or Paper, Fabric, Forge. The world is kept in a volume and backed up like any other.",
      "website": "https://www.minecraft.net",
      "docs": "https://docker-minecraft-server.readthedocs.io",
      "icon": "minecraft",
      "category": "games",
      "tags": [
        "java",
        "paper",
        "fabric",
        "forge"
      ],
      "inputs": [
        {
          "name": "EULA",
          "label": "I accept the Minecraft EULA",
          "type": "checkbox",
          "help": "Mojang's terms for running a server, https://aka.ms/MinecraftEULA. The server doesn't start without it.",
          "required": true
        },
        {
          "name": "SERVER_TYPE",
          "label": "Server type",
          "type": "select",
          "options": [
            "VANILLA",
            "PAPER",
            "FABRIC",
            "FORGE",
            "NEOFORGE",
            "PURPUR"
          ],
          "default": "VANILLA"
        },
        {
          "name": "VERSION",
          "label": "Minecraft version",
          "type": "text",
          "help": "LATEST, or a version like 1.21.4.",
          "default": "LATEST"
        },
        {
          "name": "MEMORY",
          "label": "Memory",
          "type": "text",
          "help": "The container's memory limit; the server gets three quarters of it.",
          "default": "2g"
        },
        {
          "name": "PORT",
          "label": "Port",
          "type": "text",
          "help": "The host port players connect to. Open it in the server's firewall.",
          "default": "25565"
        },
        {
          "name": "DIFFICULTY",
          "label": "Difficulty",
          "type": "select",
          "options": [
            "peaceful",
            "easy",
            "normal",
            "hard"
          ],
          "default": "normal"
        },
        {
          "name": "MODE",
          "label": "Game mode",
          "type": "select",
          "options": [
            "survival",
            "creative",
            "adventure"
          ],
          "default": "survival"
        },
        {
          "name": "MOTD",
          "label": "Message of the day",
          "type": "text",
          "default": "A kipitiny Minecraft server"
        },
        {
          "name": "DOMAIN",
          "label": "Domain",
          "type": "domain",
          "help": "A DNS name pointing at this server, for players to connect with (with the port when it isn't 25565).",
          "placeholder": "mc.example.com"
        },
        {
          "name": "RCON_PASSWORD",
          "label": "RCON password",
          "type": "secret",
          "generate": 24
        }
      ],
      "project": "minecraft",
      "compose": "",
      "services": [
        {
          "name": "server",
          "kind": "app",
          "image": "itzg/minecraft-server",
          "icon": "minecraft",
          "memoryMb": 2048,
          "publishedPorts": [
            {
              "hostPort": 25565,
              "containerPort": 25565,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "name": "data",
              "path": "/data"
            }
          ],
          "domainInput": "DOMAIN"
        }
      ]
    }
  ],
  "logos": [
    {
