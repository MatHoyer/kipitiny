# Managed by kipitiny's Ansible playbook.
KIPITINY_VERSION={{ kipitiny_version }}
KIPITINY_UI_PORT={{ kipitiny_ui_port }}
KIPITINY_DOMAIN={{ kipitiny_domain }}
KIPITINY_ACME_EMAIL={{ kipitiny_acme_email }}
KIPITINY_CLOUDFLARE_TUNNEL_TOKEN={{ kipitiny_cloudflare_tunnel_token }}
{% for k, v in kipitiny_env.items() %}
{{ k }}={{ v }}
{% endfor %}
